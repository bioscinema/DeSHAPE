library(BetaTREND)
set.seed(123)
# Simulate data
n <- 200
z1 <- rnorm(n)
z2 <- rbinom(n, 1, 0.5)
z <- data.frame(z1, z2)
# Continuous exposure x depends on z
x <- 0.5 * z1 + 0.3 * z2 + rnorm(n)
# Trait y shows increasing trend with x
y <- rank(x) + rnorm(n, sd = 5)
# Run the test
result_cont <- CA_cjtu_test(x, y, z, var_method = "jackknife", alternative = "increasing")
print(result_cont)
set.seed(456)
# Simulate data
n <- 200
z1 <- rnorm(n)
z2 <- rbinom(n, 1, 0.5)
z <- data.frame(z1, z2)
# Ordinal x depends on z
latent_score <- 0.8 * z1 - 0.5 * z2 + rnorm(n)
x_ord <- cut(latent_score, breaks = quantile(latent_score, probs = c(0, 0.33, 0.66, 1)),
labels = c("Low", "Medium", "High"), include.lowest = TRUE, ordered_result = TRUE)
# Trait y increases with level of x
y <- as.numeric(x_ord) + rnorm(n, sd = 1)
# Run the test
result_ord <- CA_cjtu_test(x_ord, y, z, var_method = "jackknife", alternative = "increasing")
print(result_ord)
